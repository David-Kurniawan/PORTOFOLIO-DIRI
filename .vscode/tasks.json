{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start portfolio server",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8000",
                "--bind",
                "0.0.0.0"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "endsPattern": "^Serving HTTP on .* port 8000"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        }
    ]
}
